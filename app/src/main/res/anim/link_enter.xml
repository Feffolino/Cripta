<?xml version="1.0" encoding="utf-8"?>
<!-- A link's page (Custom Tab) arrives like any Cripta page: from the right, fading in (AppRoot pageEnter). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/cripta_ease_out_quart"
    android:shareInterpolator="true">
    <translate android:fromXDelta="12%p" android:toXDelta="0" android:duration="320" />
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="220" android:startOffset="60" />
</set>
