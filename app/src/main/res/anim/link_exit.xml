<?xml version="1.0" encoding="utf-8"?>
<!-- Back from a link page: the page leaves to the right, fading out (AppRoot pagePopExit). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/cripta_ease_out_quart"
    android:shareInterpolator="true">
    <translate android:fromXDelta="0" android:toXDelta="12%p" android:duration="240" />
    <alpha android:fromAlpha="1" android:toAlpha="0" android:duration="180" />
</set>
